# ---------------------------------------------------------------------------
# AI Technical Interviewer — environment
#
# Every key below is OPTIONAL. With no keys at all the app still runs a
# complete interview end to end:
#   - the interviewer falls back to a built-in rule-based interviewer that
#     uses each problem's authored hint ladder and follow-up questions
#   - voice falls back to the browser's built-in Web Speech API
#     (speech recognition + speech synthesis)
#   - code execution always runs locally against your installed
#     node / python3 / java toolchains
# Add keys to upgrade each layer.
# ---------------------------------------------------------------------------

# --- Interviewer brain -----------------------------------------------------
# Provider is auto-detected from whichever key is present.
# Force one explicitly with: gemini | anthropic | none
LLM_PROVIDER=

# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Voice -----------------------------------------------------------------
# ElevenLabs text-to-speech for the interviewer's voice.
# Without this, the browser's built-in speech synthesis is used instead.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# "Adam" — a calm, neutral interviewer voice. Browse: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Code execution --------------------------------------------------------
# Per-test wall-clock limit (ms) and max captured output (bytes).
RUNNER_TIMEOUT_MS=6000
RUNNER_MAX_OUTPUT=20000
