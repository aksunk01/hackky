GEMINI_API_KEY=

# Optional: override the interviewer/evaluator model. Defaults to
# gemini-3.5-flash, whose free-tier quota is usable; gemini-3.6-flash allows
# only 20 requests and 429s almost immediately, and gemini-2.5-* 404s on v1beta.
# GEMINI_MODEL=

# Enables Claude as an alternative AI interviewer/evaluator, selectable from
# the problem picker. Without it, choosing Claude falls back to scripted replies.
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Defaults to claude-opus-5.
# CLAUDE_MODEL=

# Enables the interviewer's voice (ElevenLabs TTS) and speech-to-text.
# Without it, /api/stream-speech and /api/transcribe-audio return 503 and the
# app falls back to the browser's built-in speech recognition.
ELEVENLABS_API_KEY=

# Required for saved interview reports, stored in Cloud Firestore. Create a
# Firebase project, enable Firestore (Standard Edition), then generate a
# service account key from Project settings -> Service accounts and fill in
# its fields below. FIREBASE_PRIVATE_KEY must keep its \n sequences escaped
# (paste the key from the JSON file as-is, on one line, wrapped in quotes).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required for login (email/password + Google via Firebase Auth). From the
# same Firebase project: Project settings -> General -> "Your apps" -> add a
# web app -> copy its firebaseConfig values below. These are public/client-side
# values, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: override the TTS voice. Defaults to Sarah (EXAVITQu4vr4xnSDxMaL),
# a premade voice that works on free plans.
# ELEVENLABS_VOICE_ID=

# Required to store user-provided API keys (Settings page). Any random string;
# generate one with `openssl rand -hex 32`.
SETTINGS_ENCRYPTION_KEY=
